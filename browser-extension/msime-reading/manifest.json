{
  "manifest_version": 3,
  "name": "水杉阅读翻译",
  "version": "1.0.0",
  "description": "右键翻译选中文字，复用本机 MSIME 的 API 配置和本地缓存。",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "水杉阅读翻译"
  }
}